const SPREADSHEET_ID="1yeMOc1EcoDCccMtFYIYPUrfYNzBcPTHQLQBNT2LSPEs",MASTER_SHEET="Data Mahasiswa",LOG_SHEET="Presensi",TIMEZONE="Asia/Jakarta",START_TIME="11:00",END_TIME="13:30";
function doGet(e){try{const a=e?.parameter?.action;if(!a)return json({success:true,message:"Presensi API aktif.",spreadsheet:SPREADSHEET_ID,masterSheet:MASTER_SHEET,logSheet:LOG_SHEET});if(a==="find"){const s=findStudentByNim_(String(e.parameter.nim||"").trim());return s?json({success:true,data:s}):json({success:false,message:"Mahasiswa tidak ditemukan."})}return json({success:false,message:"Action tidak dikenali."})}catch(x){return json({success:false,message:x.message})}}
function doPost(e){const lock=LockService.getScriptLock();lock.waitLock(15000);try{const b=JSON.parse(e.postData.contents||"{}"),nim=String(b.nim||"").trim();if(!nim)throw Error("NIM wajib diisi.");const s=findStudentByNim_(nim);if(!s)throw Error("Mahasiswa tidak ditemukan.");const now=new Date(),hm=Utilities.formatDate(now,TIMEZONE,"HH:mm");if(hm<START_TIME)throw Error("Presensi belum dibuka.");if(hm>=END_TIME)throw Error("Presensi sudah ditutup.");const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(LOG_SHEET);if(!sh)throw Error("Sheet Presensi tidak ditemukan.");const mk=String(b.mataKuliah||s.mataKuliah||"").trim(),w=Utilities.formatDate(now,TIMEZONE,"dd/MM/yyyy HH:mm:ss");if(duplicate_(sh,nim,Utilities.formatDate(now,TIMEZONE,"yyyy-MM-dd"),mk))throw Error("Mahasiswa sudah melakukan presensi pada sesi ini.");sh.appendRow([w,s.nim,s.nama,s.kelas,s.jurusan,mk,"Hadir"]);return json({success:true,message:"Presensi berhasil.",data:{waktu:w,nim:s.nim,nama:s.nama,kelas:s.kelas,jurusan:s.jurusan,mataKuliah:mk,status:"Hadir"}})}catch(x){return json({success:false,message:x.message})}finally{lock.releaseLock()}}
function findStudentByNim_(nim){const sh=SpreadsheetApp.openById(SPREADSHEET_ID).getSheetByName(MASTER_SHEET);if(!sh)throw Error("Sheet Data Mahasiswa tidak ditemukan.");const v=sh.getDataRange().getDisplayValues(),h=v[0].map(x=>String(x).trim().toLowerCase()),i=n=>h.indexOf(n.toLowerCase());for(let r=1;r<v.length;r++)if(String(v[r][i("nim")]||"").trim()===nim)return{nim:String(v[r][i("nim")]||"").trim(),nama:String(v[r][i("nama")]||"").trim(),kelas:String(v[r][i("kelas")]||"").trim(),jurusan:String(v[r][i("jurusan")]||"").trim(),status:i("status")>=0?String(v[r][i("status")]||"").trim():"",mataKuliah:i("mata kuliah")>=0?String(v[r][i("mata kuliah")]||"").trim():"",waktu:i("waktu")>=0?String(v[r][i("waktu")]||"").trim():""};return null}
function duplicate_(sh,nim,date,mk){const v=sh.getDataRange().getDisplayValues();for(let r=1;r<v.length;r++){const m=String(v[r][0]||"").match(/^(\d{2})\/(\d{2})\/(\d{4})/);if(m&&String(v[r][1]||"").trim()===nim&&`${m[3]}-${m[2]}-${m[1]}`===date&&String(v[r][5]||"").trim()===mk)return true}return false}
function json(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}